# Local first-time users: pnpm run setup generates .env automatically.
# This template is for manual/server configuration. Never commit actual credentials.
# Runtime has data permissions only. Generate two different passwords with openssl rand -hex 32.
DATABASE_URL=postgres://athlete_panel_app:replace-with-app-password@127.0.0.1:55440/athlete_panel
# Console migration/bootstrap/recovery only; never pass this to web or worker.
ADMIN_DATABASE_URL=postgres://athlete_panel:replace-with-admin-password@127.0.0.1:55440/athlete_panel
APP_DATABASE_PASSWORD=
# Independent 32-byte random keys, base64 encoded. Never commit real values.
ENCRYPTION_KEY=
APP_ORIGIN=http://127.0.0.1:3000
# HTTPS production must use secure cookies.
COOKIE_SECURE=false
ATHLETE_PANEL_INSTANCE_PATH=instance/composition.json
# Production Compose: choose a real hostname and immutable release tag.
ATHLETE_PANEL_DOMAIN=training.example.com
ATHLETE_PANEL_RELEASE=local
POSTGRES_DB=athlete_panel
POSTGRES_USER=athlete_panel
APP_DATABASE_ROLE=athlete_panel_app
# Local database bootstrap and production admin service; match ADMIN_DATABASE_URL.
POSTGRES_PASSWORD=
# Set true only behind the provided Caddy proxy with a private web port.
TRUST_PROXY_CLIENT_IP=false
# Mounted, off-host storage; keep the independent 32-byte base64 backup key separately.
BACKUP_DESTINATION=/absolute/path/to/off-host-backups
BACKUP_KEY_FILE=/absolute/path/to/private-backup.key
BACKUP_HOUR_UTC=3
